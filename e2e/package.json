    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:auth": "playwright test tests/auth",
    "test:patient": "playwright test tests/patient",
    "test:pharmacist": "playwright test tests/pharmacist",
    "test:doctor": "playwright test tests/doctor",
    "test:nurse": "playwright test tests/nurse",
    "test:delivery": "playwright test tests/delivery",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.40.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.3"
