{
  "name": "@metapharm/delivery-app",
  "version": "0.1.0",
  "private": true,
  "description": "MetaPharm Connect - Delivery Personnel Mobile Application",
  "main": "src/App.tsx",
  "scripts": {
    "start": "react-native start --reset-cache",
    "android": "react-native run-android",
    "ios": "react-native run-ios",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint 'src/**/*.{ts,tsx}'",
    "lint:fix": "eslint 'src/**/*.{ts,tsx}' --fix",
    "format": "prettier --write 'src/**/*.{ts,tsx}'",
    "type-check": "tsc --noEmit",
    "e2e:build:ios": "detox build --configuration ios.sim.debug",
    "e2e:test:ios": "detox test --configuration ios.sim.debug",
    "e2e:test:ios:release": "detox test --configuration ios.sim.release",
    "e2e:build:android": "detox build --configuration android.emu.debug",
    "e2e:test:android": "detox test --configuration android.emu.debug",
    "e2e:test:android:release": "detox test --configuration android.emu.release",
    "e2e:maestro": "maestro test e2e/.maestro/",
    "e2e:maestro:single": "maestro test"
  },
  "dependencies": {
    "react": "18.2.0",
    "react-native": "0.73.4",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/stack": "^6.3.29",
    "@react-navigation/bottom-tabs": "^6.5.20",
    "@reduxjs/toolkit": "^2.2.1",
    "react-redux": "^9.1.0",
    "redux-persist": "^6.0.0",
    "react-native-camera": "^4.2.1",
    "react-native-qrcode-scanner": "^1.5.5",
    "react-native-permissions": "^4.1.4",
    "react-native-safe-area-context": "^4.9.0",
    "react-native-screens": "^3.29.0",
    "react-native-gesture-handler": "^2.15.0",
    "react-native-reanimated": "^3.7.1",
    "react-native-maps": "^1.14.0",
    "react-native-geolocation-service": "^5.3.1",
    "@react-native-community/netinfo": "^11.3.1",
    "axios": "^1.6.7",
    "@react-native-async-storage/async-storage": "^1.22.2",
    "date-fns": "^3.3.1",
    "@metapharm/api-types": "^0.1.0",
    "expo-haptics": "^15.0.3",
    "react-native-signature-canvas": "^4.7.2"
  },
  "devDependencies": {
    "@types/react": "^18.2.57",
    "@types/react-native": "^0.73.0",
    "typescript": "^5.3.3",
    "jest": "^29.7.0",
    "@testing-library/react-native": "^12.4.3",
    "@testing-library/jest-native": "^5.4.3",
    "react-test-renderer": "18.2.0"
  }
}
