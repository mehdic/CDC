# e-Santé Service Configuration
# Copy this file to .env and fill in actual values

# Server Configuration
PORT=3010
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-here-min-32-chars

# HIN Authentication Configuration
HIN_API_URL=https://hin.api.example.com
HIN_CLIENT_ID=your-hin-client-id
HIN_CLIENT_SECRET=your-hin-client-secret

# Vaud (VD) Configuration - CARA Platform
VAUD_CARA_API_URL=https://cara.vaud.ch/api
VAUD_XDS_REGISTRY=https://xds.vaud.ch
VAUD_CLIENT_ID=vaud-client-id
VAUD_CLIENT_SECRET=vaud-client-secret

# Geneva (GE) Configuration - MonDossierMedical
GENEVA_MDM_API_URL=https://mondossiermédical.ge.ch/api
GENEVA_CLIENT_ID=geneva-client-id
GENEVA_CLIENT_SECRET=geneva-client-secret

# Zurich (ZH) Configuration - EPD System
ZURICH_EPD_API_URL=https://epd.zh.ch/api
ZURICH_EPD_PROVIDER=EHRsys
ZURICH_CLIENT_ID=zurich-client-id
ZURICH_CLIENT_SECRET=zurich-client-secret

# Logging
LOG_LEVEL=info
