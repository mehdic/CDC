# Medical Records Service Configuration

# Server
NODE_ENV=development
MEDICAL_RECORDS_SERVICE_PORT=4010

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=medical_records_service
DB_SYNCHRONIZE=true
DB_LOGGING=false

# CORS
CORS_ORIGIN=http://localhost:3000

# Swiss e-santé API (stub)
ESANTE_API_URL=https://api.e-sante.ch
ESANTE_API_KEY=your_api_key_here

# HIN e-ID Provider (stub)
HIN_CLIENT_ID=your_hin_client_id
HIN_CLIENT_SECRET=your_hin_client_secret
HIN_AUTH_URL=https://hin.ch/auth
