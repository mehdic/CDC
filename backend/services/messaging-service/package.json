{
  "name": "@metapharm/messaging-service",
  "version": "1.0.0",
  "description": "MetaPharm Connect - Multi-Channel Messaging Service (WhatsApp, Email, Fax, In-App)",
  "main": "src/index.ts",
  "scripts": {
    "dev": "nodemon --exec ts-node src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
