  "loginWithMFAExample": {
    "title": "Login with MFA Required",
    "endpoint": "POST /api/auth/login",
    "request": {
      "headers": {
        "Content-Type": "application/json"
      },
      "body": {
        "email": "doctor@metapharm.ch",
        "password": "SecurePassword123!"
      }
    },
    "response": {
      "statusCode": 200,
      "body": {
        "success": true,
        "requiresMFA": true,
        "tempToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJ1c2VyLTEyMyIsInR5cGUiOiJ0ZW1wIiwiaWF0IjoxNzAxNDMyMDAwLCJleHAiOjE3MDE0MzI2MDB9.aB1cDeFg...",
        "mfaMethod": "totp"
      }
    }
  },
