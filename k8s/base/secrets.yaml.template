# MetaPharm Connect - Secrets Template
# =============================================
# WARNING: This is a TEMPLATE file only!
# DO NOT commit actual secrets to version control!
#
# Usage:
# 1. Copy this file to secrets.yaml
# 2. Replace placeholder values with real secrets
# 3. Apply with: kubectl apply -f secrets.yaml
# 4. Delete the secrets.yaml file
#
# For production, use:
# - External Secrets Operator with HashiCorp Vault
# - Sealed Secrets for GitOps
# - Cloud provider secret managers (AWS Secrets Manager, GCP Secret Manager)
# =============================================
apiVersion: v1
kind: Secret
metadata:
  name: metapharm-secrets
  namespace: metapharm
  labels:
    app.kubernetes.io/name: metapharm
    app.kubernetes.io/part-of: metapharm-connect
type: Opaque
stringData:
  # Database credentials
  # REPLACE with actual values (base64 encoded when using 'data' instead of 'stringData')
  POSTGRES_HOST: "postgres.metapharm.svc.cluster.local"
  POSTGRES_PORT: "5432"
  POSTGRES_USER: "<REPLACE_WITH_DB_USERNAME>"
  POSTGRES_PASSWORD: "<REPLACE_WITH_STRONG_PASSWORD>"
  POSTGRES_DB: "metapharm_db"
  DATABASE_URL: "postgresql://<USER>:<PASSWORD>@postgres.metapharm.svc.cluster.local:5432/metapharm_db"

  # Redis credentials
  REDIS_HOST: "redis.metapharm.svc.cluster.local"
  REDIS_PORT: "6379"
  REDIS_PASSWORD: "<REPLACE_WITH_REDIS_PASSWORD>"
  REDIS_URL: "redis://:<PASSWORD>@redis.metapharm.svc.cluster.local:6379"

  # JWT secrets (use cryptographically secure random strings)
  JWT_SECRET: "<REPLACE_WITH_256_BIT_SECRET>"
  JWT_REFRESH_SECRET: "<REPLACE_WITH_DIFFERENT_256_BIT_SECRET>"

  # API keys for external services
  HIN_EID_API_KEY: "<REPLACE_WITH_HIN_API_KEY>"
  ESANTE_API_KEY: "<REPLACE_WITH_ESANTE_API_KEY>"
  TWILIO_API_KEY: "<REPLACE_WITH_TWILIO_KEY>"
  STRIPE_API_KEY: "<REPLACE_WITH_STRIPE_KEY>"

  # Encryption keys
  ENCRYPTION_KEY: "<REPLACE_WITH_AES_256_KEY>"

  # Monitoring
  SENTRY_DSN: "<REPLACE_WITH_SENTRY_DSN>"
---
# TLS Certificate secret template
apiVersion: v1
kind: Secret
metadata:
  name: metapharm-tls
  namespace: metapharm
  labels:
    app.kubernetes.io/name: metapharm
type: kubernetes.io/tls
data:
  # Base64 encoded TLS certificate
  tls.crt: "<REPLACE_WITH_BASE64_CERTIFICATE>"
  # Base64 encoded TLS private key
  tls.key: "<REPLACE_WITH_BASE64_PRIVATE_KEY>"
---
# Image pull secret template (for private registry)
apiVersion: v1
kind: Secret
metadata:
  name: metapharm-registry
  namespace: metapharm
type: kubernetes.io/dockerconfigjson
data:
  # Base64 encoded docker config.json
  .dockerconfigjson: "<REPLACE_WITH_BASE64_DOCKER_CONFIG>"
